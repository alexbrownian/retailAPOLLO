# Credential template. Copy to `.env` at the project root and fill in the
# values; `.env` itself is gitignored and never leaves the machine it is on.
#
# The fetchers parse `.env` directly and fall back to os.environ, so any
# value may also be supplied as an environment variable instead.
# Check what a machine has without printing secrets:
#
#     python ingestion/fetch_all.py --check
#
# A machine with no credentials still runs: the fetch stages report
# themselves as off and the pipeline recomputes from the aggregates on disk.

# --- FetchLayer (third-party Reddit/X data API, fetchlayer.dev) ----------
# The live source for both Reddit and X. One credit per request.
FETCHLAYER_KEY=

# --- Reddit official API (unused while FetchLayer is the live source) ---
REDDIT_APP_NAME=
REDDIT_PERSONAL_USE=
REDDIT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- X / Twitter (official v2 API, paid; leave empty to disable) --------
X_BEARER_TOKEN=

# --- AI layer: provider selection -----------------------------------------
# 'auto' (default) tries Apollo, then falls back to Anthropic. Name one
# provider to pin it and skip the other entirely.
AI_PROVIDER=auto

# Apollo gateway (reachable from the desk machine, on the VPN, only).
ENVIRONMENT=
APOLLO_AUTH_USERNAME=
APOLLO_AUTH_PASSWORD=
AI_MODEL=
AI_DATA_CLASSIFICATION=

# Anthropic (Claude API direct). Needs only this key and a network route,
# so a machine off the VPN still regenerates the AI Pulse and the agentic
# digest instead of degrading to PENDING banners.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Hard per-process call budget; a runaway loop hits this, never a provider.
AI_MAX_CALLS=
