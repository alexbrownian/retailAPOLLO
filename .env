# Real credentials - this file is git-ignored (see .gitignore line 12).
# Template + docs: example.env / data_ingestion/LIVE_INGESTION.md

# --- FetchLayer (third-party Reddit/X data API, fetchlayer.dev) ---
# Used by data_ingestion/scripts/fetch_reddit_live.py
# 1 credit per request; free tier = 30 requests, then pay-as-you-go.
FETCHLAYER_KEY= ss-18233eb2ed288e1aff01d0e2f46fb24fa00d9965f03c42160b6fc8acc0fd

# --- Reddit official API (unused while FetchLayer is the live source) ---
REDDIT_APP_NAME=
REDDIT_PERSONAL_USE=
REDDIT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- X / Twitter (official v2 API - paid; empty = fetch_x_live.py no-ops) ---
X_BEARER_TOKEN=

# --- AI layer (Apollo gateway via dimsum_lite; desk machine + VPN only) ---
# Auth handled by dimsum_lite from these (Apollo/Delphi-X onboarding).
# The AI pulse, poll and keyword auditor all skip politely without them.
ENVIRONMENT=DEV
APOLLO_AUTH_USERNAME=brownale
APOLLO_AUTH_PASSWORD=
AI_MODEL=gpt-4o
AI_DATA_CLASSIFICATION=RESTRICTED
AI_MAX_CALLS=40
# AI_MOCK=1        # offline deterministic outputs (testing only)
